{
  "rules": {
    "daily": {
      "$day": {
        ".read": true,
        "$entry": {
          ".write": "!data.exists()",
          ".validate": "newData.hasChildren(['n', 's']) && newData.child('n').isString() && newData.child('n').val().matches(/^[A-Z0-9]{1,3}$/) && newData.child('s').isNumber() && newData.child('s').val() > 0 && newData.child('s').val() <= 5000"
        }
      }
    },
    "best": {
      ".read": true,
      "$name": {
        ".write": "$name.matches(/^[A-Z0-9]{1,3}$/) && (!data.exists() || newData.child('s').val() > data.child('s').val())",
        ".validate": "newData.hasChildren(['s']) && newData.child('s').isNumber() && newData.child('s').val() > 0 && newData.child('s').val() <= 5000"
      }
    }
  }
}
